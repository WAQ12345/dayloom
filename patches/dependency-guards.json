    "content": "'use strict';\n// Local mitigation for GHSA-vfj7-8cjw-p6xm; only follow child edges, never parent/prev.\nmodule.exports = ast => {\n  const pending = [[ast, 0]], seen = new Set(); let count = 0;\n  while (pending.length) {\n    const [node, depth] = pending.pop();\n    if (!node || typeof node !== 'object') continue;\n    if (depth > 128 || ++count > 65536 || seen.has(node)) throw new SyntaxError('Brace AST exceeds safe bounds');\n    seen.add(node);\n    if (Array.isArray(node.nodes)) for (const child of node.nodes) pending.push([child, depth + 1]);\n  }\n};\n"
  },
