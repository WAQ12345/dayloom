{
  "name": "dayloom",
  "version": "1.1.23",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "57.0.21",
    "expo-dev-client": "57.0.19",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.12",
    "expo-notifications": "57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "fflate": "0.8.3",
    "lunar-typescript": "1.8.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint src tests",
    "build:android": "./scripts/build-local-release.sh",
    "postinstall": "node scripts/apply-dependency-guards.cjs",
    "verify:guards": "node scripts/apply-dependency-guards.cjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "description": "A local-first life organizer with AI on your terms.",
  "license": "MIT"
}
